# MEDIMIND Environment Template
# Copy this file to .env and fill in your values:
#   copy .env.example .env

# Application
APP_NAME=MEDIMIND
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# MongoDB (local via docker-compose or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=medimind

# PostgreSQL (local via docker-compose or cloud provider)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=medimind_user
POSTGRES_PASSWORD=medimind_pass
POSTGRES_DB=medimind_db
DATABASE_URL=postgresql+asyncpg://medimind_user:medimind_pass@localhost:5432/medimind_db

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here


# ML Model
MODEL_PATH=backend/trained_models/disease_model.pkl

# Reports
REPORTS_DIR=reports

# Default Doctor (seeded on first startup)
DEFAULT_DOCTOR_EMAIL=doctor@medimind.com
DEFAULT_DOCTOR_PASSWORD=doctor123
DEFAULT_DOCTOR_NAME=Dr. Admin

